#!/usr/bin/env bash
set -eu
ip link set "$INTERFACE" up
ip addr add {{ (tinc_vpn_subnet ~ '.' ~ tinc_vpn_ip_last ~ '/' ~ tinc_vpn_netmask) | quote }} dev "$INTERFACE"

# Multicast route over the tunnel (iproute2 - net-tools may not be installed)
ip route replace 224.0.0.0/4 dev "$INTERFACE" || true
{% if tinc_ip_forwarding %}

# Enable IP forwarding
sysctl -w net.ipv4.ip_forward=1
{% endif %}
