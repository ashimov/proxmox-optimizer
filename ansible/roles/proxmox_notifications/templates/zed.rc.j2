# Managed by Ansible (proxmox_notifications). Local edits will be overwritten.
ZED_EMAIL_ADDR="{{ proxmox_notifications_email }}"
ZED_EMAIL_PROG="mail"
ZED_EMAIL_OPTS="-s '@SUBJECT@' @ADDRESS@"
ZED_NOTIFY_INTERVAL_SECS=3600
ZED_NOTIFY_VERBOSE={{ 1 if proxmox_notifications_zed_verbose else 0 }}
ZED_USE_ENCLOSURE_LEDS=1
ZED_SCRUB_AFTER_RESILVER=1
